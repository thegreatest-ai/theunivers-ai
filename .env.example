# Copy to .env. Production does not use this file at all — on Fly every variable below is a real
# environment variable or a `fly secret`, and there is no .env in the image.
#
# ─── A VALUE MAY BE A REFERENCE ──────────────────────────────────────────────────────────
#
#   GOOGLE_CLIENT_SECRET=keychain:GOOGLE_CLIENT_SECRET
#
# means "read it from the macOS login Keychain, account theunivers-ai". SECRETS-POLICY.md is
# Keychain-first, and until the loader could resolve these the only way to run locally was to paste
# the real value here — so the policy was followed and the plaintext appeared anyway.
#
# Store one with `npm run secret <NAME>` (hidden input → Keychain → Fly). An unresolvable
# reference leaves the variable UNSET and says so at boot; it never becomes the literal string.
# On Linux/CI there is no `security` binary, so pass real environment variables there.

PORT=8790
BASE_URL=http://localhost:8790
FRONTEND_URL=http://localhost:5188

# Set false to open registration to anyone. Default is true: an absent or malformed value
# must never silently open the door.
INVITE_REQUIRED=true
INVITE_CODE=keychain:INVITE_CODE
INVITE_MAX_USES=50

DB_PATH=./data/pilot.db

# The one origin allowed to call this API from a browser. Leave UNSET and the server defaults to
# BASE_URL, which is what a same-origin deploy wants — production sets nothing. `*` was the shipped
# example and it teaches every copy of this file to allow the whole internet.
CORS_ORIGIN=http://localhost:5188

# Google OAuth (Gmail) — https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:8790/api/auth/google/callback
# The id is NOT secret (it appears in the sign-in URL); the secret is.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=keychain:GOOGLE_CLIENT_SECRET

# GitHub OAuth App — https://github.com/settings/developers
# Authorization callback URL: http://localhost:8790/api/auth/github/callback
# Unset is a supported state: the server reports "Github off" and the button does not render.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Mail. Without RESEND_API_KEY, production DROPS reset emails (safely — the token is never
# returned to the caller); development logs them to stdout instead.
RESEND_API_KEY=keychain:RESEND_API_KEY

# Signs the OAuth state parameter. Generated, not issued: openssl rand -hex 32
# This said `change-me` for months, which is how a signing key stays unchanged.
OAUTH_STATE_SECRET=keychain:OAUTH_STATE_SECRET

# Operator credential. Gates /api/metrics AND every moderation act (limit, takedown, dismiss).
# Unset means /api/metrics 404s — off by default rather than open by accident.
METRICS_TOKEN=keychain:METRICS_TOKEN
