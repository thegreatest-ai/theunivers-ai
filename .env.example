PORT=8790
BASE_URL=http://localhost:8790
FRONTEND_URL=http://localhost:5188
# Set false to open registration to anyone. Default is true: an absent or malformed value
# must never silently open the door.
INVITE_REQUIRED=true
INVITE_CODE=univers-pilot
INVITE_MAX_USES=50
DB_PATH=./data/pilot.db
CORS_ORIGIN=*

# Google OAuth (Gmail) — https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:8790/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth App — https://github.com/settings/developers
# Authorization callback URL: http://localhost:8790/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Mail — until SMTP_HOST is set, /api/auth/forgot returns the reset token in its response and
# the UI walks the user straight to the reset step instead of promising an email nobody sends.
# theunivers.ai mail is on Microsoft 365, so:
#   SMTP_HOST=smtp.office365.com
#   SMTP_PORT=587
#   SMTP_USER=support@theunivers.ai
#   SMTP_PASS=<app password>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

OAUTH_STATE_SECRET=change-me

METRICS_TOKEN=
