PORT=8790
BASE_URL=http://localhost:8790
FRONTEND_URL=http://localhost:5188
INVITE_CODE=univers-pilot
INVITE_MAX_USES=50
DB_PATH=./data/pilot.db
CORS_ORIGIN=*

# Google OAuth (Gmail) — https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:8790/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth App — https://github.com/settings/developers
# Authorization callback URL: http://localhost:8790/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Facebook Login — https://developers.facebook.com/apps
# Add the "Facebook Login" product, then Settings → Valid OAuth Redirect URIs:
#   http://localhost:8790/api/auth/facebook/callback
# NOTE: `email` is granted without App Review only while the app is in Development mode,
# and only to admins/developers/testers. Public launch needs review.
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Sign in with Apple — NOT ENABLED, and not a matter of pasting keys:
#   · requires an HTTPS return URL on a verified domain (localhost is rejected)
#   · requires a paid Apple Developer Program membership
#   · the client secret is a JWT you sign with a .p8 key, max 6 months, must be rotated
# Revisit once theunivers.ai is deployed with TLS. See appleAuthUrl() in server/oauth.mjs.

OAUTH_STATE_SECRET=change-me
