{
  "name": "theunivers-ai",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "node server/index.mjs",
    "dev:all": "node server/index.mjs & vite",
    "build": "vite build",
    "start": "node server/index.mjs",
    "test": "node scripts/rules.mjs check && node scripts/docs-check.mjs && node scripts/claims-check.mjs && node scripts/mcp-check.mjs && node --test test/*.test.mjs",
    "perf": "node scripts/perf-measure.mjs",
    "rules:sync": "node scripts/rules.mjs sync",
    "rules:check": "node scripts/rules.mjs check",
    "test:corridor": "node --test ../../products/corridor/test/smoke.ts || echo '(corridor not present \u2014 skipped)'",
    "deploy": "npm run build && node --test test/renders.test.mjs && fly deploy",
    "secret": "node scripts/set-secret.mjs",
    "claims": "node scripts/claims-check.mjs",
    "spend": "node scripts/fly-spend.mjs --budget 15",
    "spend:dash": "node scripts/fly-spend.mjs --budget 15 --dashboard",
    "deploy:logs": "fly logs",
    "secrets:check": "fly ssh console -C \"printenv | grep -E '^(GOOGLE|GITHUB|INVITE|OAUTH|SMTP)' | sed 's/=.*/=\u00abset\u00bb/'\"",
    "mcp:check": "node scripts/mcp-check.mjs"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "@react-three/drei": "^9.114.0",
    "@react-three/fiber": "^8.17.10",
    "@react-three/postprocessing": "^2.16.3",
    "gsap": "^3.15.0",
    "lenis": "^1.3.25",
    "maath": "^0.10.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.4",
    "three": "^0.160.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.3",
    "vite": "^5.4.10"
  }
}
